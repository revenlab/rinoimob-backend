DB_URL=jdbc:postgresql://localhost:5432/rinoimob
DB_USER=user
DB_PASSWORD=pass
SPRING_PROFILE=dev

# Mail (use Mailtrap for dev, Gmail/SendGrid/SES for production)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Evolution API (WhatsApp) — use the same key configured in your Evolution API instance
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=changeme-evolution-apikey

# Billing (Asaas v3; use https://api-sandbox.asaas.com in development)
ASAAS_BASE_URL=https://api-sandbox.asaas.com
RENTAL_ASAAS_BASE_URL=https://api-sandbox.asaas.com
RENTAL_ASAAS_ROOT_API_KEY=
RENTAL_ASAAS_RINO_WALLET_ID=
RENTAL_ASAAS_ENCRYPTION_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_CHECKOUT_CALLBACK_BASE_URL=https://app-dev.example.com
ASAAS_BILLING_TYPES=CREDIT_CARD
ASAAS_CHECKOUT_EXPIRATION_MINUTES=60
ASAAS_WEBHOOK_PROCESSING_INTERVAL_MS=2000
ASAAS_PROVIDER_OPERATION_INTERVAL_MS=30000
ASAAS_RECONCILIATION_INTERVAL_MS=900000
ASAAS_PAST_DUE_SCAN_INTERVAL_MS=3600000
# Enable only after the frontend generates Asaas card tokens without sending PAN/CVV to this API.
ASAAS_CARD_TOKEN_UPDATE_ENABLED=false

# Lead integrations (use a stable random value with at least 32 characters)
INTEGRATIONS_ENCRYPTION_KEY=
INTEGRATIONS_PROCESSING_INTERVAL_MS=2000
INTEGRATIONS_QUOTA_RECHECK_INTERVAL_MS=3600000
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:39000/api/v1/integrations/meta/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=
META_LEAD_SYNC_ENABLED=true
META_LEAD_SYNC_INTERVAL_SECONDS=300
META_LEAD_SYNC_OVERLAP_SECONDS=3600
META_LEAD_SYNC_SETTLE_SECONDS=60
GRUPO_OLX_SECRET_KEY=

# AI Language Model Integration
# Provider: gemini, mock, openai (when implemented)
AI_PROVIDER=gemini

# Google Gemini Configuration (SDK Official)
# Get your API key at: https://ai.google.dev/
# Available models: gemini-2.5-flash (recommended), gemini-2.5-pro, gemini-2.0-flash
# See: https://ai.google.dev/gemini-api/docs/models?hl=pt-br
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
