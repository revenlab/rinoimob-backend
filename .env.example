DB_URL=jdbc:postgresql://localhost:5432/rinoimob
DB_USER=user
DB_PASSWORD=pass
SPRING_PROFILE=dev

# Mail (use Mailtrap for dev, Gmail/SendGrid/SES for production)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Evolution API (WhatsApp) — use the same key configured in your Evolution API instance
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=changeme-evolution-apikey

# Billing (AbacatePay v2)
ABACATEPAY_BASE_URL=https://api.abacatepay.com
ABACATEPAY_API_KEY=
ABACATEPAY_CHECKOUT_PATH=/v2/subscriptions/create
ABACATEPAY_CANCEL_PATH=/v2/subscriptions/cancel
ABACATEPAY_DEFAULT_METHOD=CARD
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_SIGNING_SECRET=
ABACATEPAY_PRODUCT_STARTER_ID=
ABACATEPAY_PRODUCT_PRIME_ID=
ABACATEPAY_PRODUCT_ULTIMATE_ID=

# AI Language Model Integration
# Provider: gemini, mock, openai (when implemented)
AI_PROVIDER=gemini

# Google Gemini Configuration (SDK Official)
# Get your API key at: https://ai.google.dev/
# Available models: gemini-2.5-flash (recommended), gemini-2.5-pro, gemini-2.0-flash
# See: https://ai.google.dev/gemini-api/docs/models?hl=pt-br
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
